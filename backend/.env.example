# VulnScope Backend environment
# Values shown are dev defaults. See root .env.example for documentation.

NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

DATABASE_CLIENT=sqlite
DATABASE_PATH=./data/vulnscope.sqlite
# PostgreSQL (production alternative)
# DATABASE_CLIENT=pg
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=vulnscope
# PGUSER=vulnscope
# PGPASSWORD=change-me

NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_REQUEST_DELAY_MS=1000

ZAP_BASE_URL=http://zap:8090
ZAP_API_KEY=

USE_EXTERNAL_LLM=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini