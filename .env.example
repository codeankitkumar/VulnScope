# =====================================================================
# VulnScope environment variables
# Copy this file to .env and fill in values. NEVER commit your real .env.
# =====================================================================

# --- General ---
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Security ---
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Database ---
# Development / tests default to SQLite via DATABASE_CLIENT=sqlite.
# For production use PostgreSQL.
DATABASE_CLIENT=sqlite
DATABASE_PATH=./data/vulnscope.sqlite
PGHOST=postgres
PGPORT=5432
PGDATABASE=vulnscope
PGUSER=vulnscope
PGPASSWORD=change-me

# --- NVD (CVE) API ---
# Obtain a free key at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_REQUEST_DELAY_MS=1000

# --- OWASP ZAP ---
ZAP_BASE_URL=http://zap:8090
ZAP_API_KEY=

# --- AI assistant ---
# Leave USE_EXTERNAL_LLM=false to use the built-in rule-based assistant.
# Set true and provide a provider key for LLM-powered explanations.
USE_EXTERNAL_LLM=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini